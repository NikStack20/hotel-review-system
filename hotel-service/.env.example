########################################
# PostgreSQL Database Configuration
########################################
HOTEL_DB_URL=jdbc:postgresql://localhost:5432/hotelDB
HOTEL_DB_USERNAME=postgres
HOTEL_DB_PASSWORD=<YOUR_POSTGRES_PASSWORD>

########################################
# Spring Cloud Config Server
########################################
CONFIG_SERVER_URL=http://localhost:7054

########################################
# Zipkin Distributed Tracing
########################################
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

########################################
# Okta OAuth2 / JWT
########################################
OKTA_ISSUER_URI=https://your-okta-domain/oauth2/default